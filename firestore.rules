
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    // Firebase Authentication is authoritative. Firestore profile roles are not:
    // historically users could write their own 'admin' or 'executive' role.
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'marcusdhaynes@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // User profiles and their private sub-collections
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      // Users may create only their own unprivileged profile. Role assignments
      // and account identity are exclusively administrator-controlled.
      allow create: if isAdmin() || (
        isOwner(userId)
        && request.resource.data.id == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'free'
        && !('groupId' in request.resource.data)
      );
      allow update: if isAdmin() || (
        isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['role', 'groupId', 'email', 'id', 'promotedAt', 'promotedBy'])
      );
      allow delete: if isAdmin();
      
      match /enrollments/{id} { allow read, write: if isOwner(userId) || isAdmin(); }
      match /caseFiles/{id} { allow read, write: if isOwner(userId) || isAdmin(); }
      match /progress/{id} { allow read, write: if isOwner(userId) || isAdmin(); }
    }

    // Generic rule for user-owned root collections
    // This pattern ensures 'list' operations work with .where('userId', '==', auth.uid)
    function isDocOwner() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }
    function isNewDocOwner() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // Notebook and Legal Study Collections
    match /user_notebooks/{id} {
      allow read, update, delete: if isDocOwner() || isAdmin();
      allow create: if isNewDocOwner() || isAdmin();
    }

    match /user_notebook_pages/{id} {
      allow read, update, delete: if isDocOwner() || isAdmin();
      allow create: if isNewDocOwner() || isAdmin();
    }

    match /user_notebook_terms/{id} {
      allow read, update, delete: if isDocOwner() || isAdmin();
      allow create: if isNewDocOwner() || isAdmin();
    }

    match /user_notebook_mistakes/{id} {
      allow read, update, delete: if isDocOwner() || isAdmin();
      allow create: if isNewDocOwner() || isAdmin();
    }

    match /user_notebook_cases/{id} {
      allow read, update, delete: if isDocOwner() || isAdmin();
      allow create: if isNewDocOwner() || isAdmin();
    }

    match /user_notebook_outlines/{id} {
      allow read, update, delete: if isDocOwner() || isAdmin();
      allow create: if isNewDocOwner() || isAdmin();
    }

    match /user_concepts/{id} {
      allow read, update, delete: if isDocOwner() || isAdmin();
      allow create: if isNewDocOwner() || isAdmin();
    }

    // Educational content collections (Global)
    match /domains/{id} { allow read: if true; allow write: if isAdmin(); }
    match /fields/{id} { allow read: if true; allow write: if isAdmin(); }
    match /courses/{id} { allow read: if true; allow write: if isAdmin(); }
    match /atomic_concepts/{id} { allow read: if true; allow write: if isAdmin(); }
    match /siteContent/{id} { allow read: if true; allow write: if isAdmin(); }
    match /groups/{id} { allow read: if true; allow write: if isAdmin(); }
  }
}
