
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    // Admin authorization never trusts /users/{uid}.role: legacy clients could
    // write it themselves. Only a verified primary owner or an authenticated,
    // individually granted administrator has authority.
    function isPrimaryAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'marcusdhaynes@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function isGrantedAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/adminGrants/$(request.auth.uid))
        && get(/databases/$(database)/documents/adminGrants/$(request.auth.uid)).data.email == request.auth.token.email
        && get(/databases/$(database)/documents/adminGrants/$(request.auth.uid)).data.role == 'admin';
    }
    function isAdmin() {
      return isPrimaryAdmin() || isGrantedAdmin();
    }

    // A user can view their own grant, but only current admins can award or
    // revoke admin access. Grant records are matched to authenticated UIDs
    // AND verified email addresses. Admin appointments are made from /admin.
    match /adminGrants/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['email','role','grantedBy','grantedAt'])
        && request.resource.data.role == 'admin'
        && request.resource.data.email is string
        && request.resource.data.email == get(/databases/$(database)/documents/users/$(userId)).data.email;
      allow delete: if isAdmin();
    }

    // User profiles and their private sub-collections
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      // Users may create only their own unprivileged profile. Role assignments
      // and account identity are exclusively administrator-controlled.
      allow create: if isAdmin() || (
        isOwner(userId)
        && request.resource.data.id == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'free'
        && !('groupId' in request.resource.data)
      );
      allow update: if isAdmin() || (
        isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['role', 'groupId', 'email', 'id', 'promotedAt', 'promotedBy'])
      );
      allow delete: if isAdmin();
      
      match /enrollments/{id} { allow read, write: if isOwner(userId) || isAdmin(); }
      match /caseFiles/{id} { allow read, write: if isOwner(userId) || isAdmin(); }
      match /progress/{id} { allow read, write: if isOwner(userId) || isAdmin(); }
    }

    // Generic rule for user-owned root collections
    // This pattern ensures 'list' operations work with .where('userId', '==', auth.uid)
    function isDocOwner() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }
    function isNewDocOwner() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // Notebook and Legal Study Collections
    match /user_notebooks/{id} {
      allow read, update, delete: if isDocOwner() || isAdmin();
      allow create: if isNewDocOwner() || isAdmin();
    }

    match /user_notebook_pages/{id} {
      allow read, update, delete: if isDocOwner() || isAdmin();
      allow create: if isNewDocOwner() || isAdmin();
    }

    match /user_notebook_terms/{id} {
      allow read, update, delete: if isDocOwner() || isAdmin();
      allow create: if isNewDocOwner() || isAdmin();
    }

    match /user_notebook_mistakes/{id} {
      allow read, update, delete: if isDocOwner() || isAdmin();
      allow create: if isNewDocOwner() || isAdmin();
    }

    match /user_notebook_cases/{id} {
      allow read, update, delete: if isDocOwner() || isAdmin();
      allow create: if isNewDocOwner() || isAdmin();
    }

    match /user_notebook_outlines/{id} {
      allow read, update, delete: if isDocOwner() || isAdmin();
      allow create: if isNewDocOwner() || isAdmin();
    }

    match /user_concepts/{id} {
      allow read, update, delete: if isDocOwner() || isAdmin();
      allow create: if isNewDocOwner() || isAdmin();
    }

    // Educational content collections (Global)
    match /domains/{id} { allow read: if true; allow write: if isAdmin(); }
    match /fields/{id} { allow read: if true; allow write: if isAdmin(); }
    match /courses/{id} { allow read: if true; allow write: if isAdmin(); }
    match /atomic_concepts/{id} { allow read: if true; allow write: if isAdmin(); }
    match /siteContent/{id} { allow read: if true; allow write: if isAdmin(); }
    match /groups/{id} { allow read: if true; allow write: if isAdmin(); }
  }
}
